{
  "name": "Triage control flow",
  "nodes": [
    {
      "id": "node-020",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        4000,
        300
      ],
      "parameters": {}
    },
    {
      "id": "node-021",
      "name": "Fetch items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4200,
        300
      ],
      "parameters": {
        "url": "https://items.example.invalid/list",
        "method": "GET"
      }
    },
    {
      "id": "node-022",
      "name": "Big enough",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        4400,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.size }}",
              "rightValue": 10,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.status }}",
              "rightValue": "open",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "node-023",
      "name": "Legacy check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        4600,
        300
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.kind }}",
              "operation": "contains",
              "value2": "bug"
            }
          ],
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 3
            }
          ]
        }
      }
    },
    {
      "id": "node-024",
      "name": "Route by kind",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        4800,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "bugs",
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "rightValue": "bug",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "ideas",
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "rightValue": "idea",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "node-025",
      "name": "Tag bug",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        5000,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "label",
              "value": "bug",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "from",
              "value": "={{ $('Fetch items').item.json.source }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "node-026",
      "name": "Tag idea",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        5200,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a3",
              "name": "label",
              "value": "idea",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "node-027",
      "name": "Combine",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        5400,
        300
      ],
      "parameters": {
        "mode": "append"
      }
    },
    {
      "id": "node-028",
      "name": "Each batch",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        5600,
        300
      ],
      "parameters": {
        "batchSize": 5
      }
    },
    {
      "id": "node-029",
      "name": "Strange set",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        5800,
        300
      ],
      "parameters": {}
    },
    {
      "id": "node-030",
      "name": "Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        6000,
        300
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Fetch items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch items": {
      "main": [
        [
          {
            "node": "Big enough",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Big enough": {
      "main": [
        [
          {
            "node": "Legacy check",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Legacy check": {
      "main": [
        [
          {
            "node": "Route by kind",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by kind": {
      "main": [
        [
          {
            "node": "Tag bug",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tag idea",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tag bug": {
      "main": [
        [
          {
            "node": "Combine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tag idea": {
      "main": [
        [
          {
            "node": "Combine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Combine": {
      "main": [
        [
          {
            "node": "Each batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Each batch": {
      "main": [
        [],
        [
          {
            "node": "Strange set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
