{
  "version": 1,
  "label": "Weekly marketing report",
  "inbox": true,
  "types": {
    "metric": {
      "label": "Metric",
      "plural": "Metrics",
      "icon": "chart-line",
      "identity": "field:key",
      "merge": "merge",
      "fields": {
        "key": {
          "label": "Key",
          "type": "text"
        },
        "source": {
          "label": "Source",
          "type": "text",
          "summary": true
        },
        "name": {
          "label": "Metric",
          "type": "text",
          "summary": true
        },
        "week": {
          "label": "Week",
          "type": "date",
          "summary": true
        },
        "value": {
          "label": "This week",
          "type": "number",
          "summary": true
        },
        "previous": {
          "label": "Last week",
          "type": "number"
        },
        "change_pct": {
          "label": "Change %",
          "type": "number",
          "summary": true
        }
      },
      "settingFilters": [
        {
          "setting": "sources",
          "field": "source"
        }
      ]
    },
    "audit": {
      "label": "Page audit",
      "plural": "Page audits",
      "icon": "file-search",
      "identity": "field:url",
      "merge": "merge",
      "fields": {
        "url": {
          "label": "URL",
          "type": "url",
          "summary": true
        },
        "title": {
          "label": "Title",
          "type": "text",
          "summary": true
        },
        "checked": {
          "label": "Checked",
          "type": "date"
        },
        "issues": {
          "label": "Issues",
          "type": "list"
        }
      }
    }
  },
  "views": [
    {
      "id": "this-week",
      "type": "metric",
      "name": "This week",
      "filters": {
        "status": "active"
      },
      "sort": {
        "field": "lastSeen",
        "dir": "desc"
      },
      "columns": [
        "source",
        "name",
        "value",
        "change_pct"
      ]
    },
    {
      "id": "page-audits",
      "type": "audit",
      "name": "Page audits",
      "filters": {
        "status": "active"
      },
      "sort": {
        "field": "lastSeen",
        "dir": "desc"
      },
      "columns": [
        "url",
        "title",
        "issues"
      ]
    }
  ],
  "learning": {
    "enabled": true
  },
  "desk": {
    "pages": [
      {
        "id": "overview",
        "title": "Overview",
        "nav": {
          "label": "Overview",
          "icon": "chart-line"
        },
        "controls": [
          "refresh",
          "dateRange",
          "filter"
        ],
        "filter": {
          "field": "source",
          "label": "Source"
        },
        "blocks": [
          {
            "id": "sessions",
            "kind": "tile",
            "label": "Sessions",
            "span": {
              "base": 12,
              "md": 4
            },
            "format": "number",
            "sparkline": true,
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "sessions"
                ]
              ],
              "x": "week",
              "aggregate": {
                "op": "latest",
                "field": "value"
              }
            }
          },
          {
            "id": "conversions",
            "kind": "tile",
            "label": "Conversions",
            "span": {
              "base": 12,
              "md": 4
            },
            "format": "number",
            "sparkline": true,
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "conversions"
                ]
              ],
              "x": "week",
              "aggregate": {
                "op": "latest",
                "field": "value"
              }
            }
          },
          {
            "id": "revenue",
            "kind": "tile",
            "label": "Revenue",
            "span": {
              "base": 12,
              "md": 4
            },
            "format": "currency",
            "sparkline": true,
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "revenue"
                ]
              ],
              "x": "week",
              "aggregate": {
                "op": "latest",
                "field": "value"
              }
            }
          },
          {
            "id": "clicks",
            "kind": "tile",
            "label": "Search clicks",
            "span": {
              "base": 12,
              "md": 4
            },
            "format": "number",
            "sparkline": true,
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "clicks"
                ]
              ],
              "x": "week",
              "aggregate": {
                "op": "latest",
                "field": "value"
              }
            }
          },
          {
            "id": "impressions",
            "kind": "tile",
            "label": "Search impressions",
            "span": {
              "base": 12,
              "md": 4
            },
            "format": "number",
            "sparkline": true,
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "impressions"
                ]
              ],
              "x": "week",
              "aggregate": {
                "op": "latest",
                "field": "value"
              }
            }
          },
          {
            "id": "position",
            "kind": "tile",
            "label": "Average position",
            "span": {
              "base": 12,
              "md": 4
            },
            "format": "number",
            "sparkline": true,
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "position"
                ]
              ],
              "x": "week",
              "aggregate": {
                "op": "latest",
                "field": "value"
              }
            }
          },
          {
            "id": "sessions-trend",
            "kind": "chart",
            "type": "line",
            "title": "Sessions by source",
            "span": {
              "base": 12,
              "md": 6
            },
            "xLabel": "Week",
            "yLabel": "Sessions",
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "sessions"
                ]
              ],
              "x": "week",
              "groupBy": "source",
              "aggregate": {
                "op": "sum",
                "field": "value"
              },
              "window": "range"
            }
          },
          {
            "id": "clicks-trend",
            "kind": "chart",
            "type": "line",
            "title": "Search clicks by source",
            "span": {
              "base": 12,
              "md": 6
            },
            "xLabel": "Week",
            "yLabel": "Clicks",
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "clicks"
                ]
              ],
              "x": "week",
              "groupBy": "source",
              "aggregate": {
                "op": "sum",
                "field": "value"
              },
              "window": "range"
            }
          },
          {
            "id": "impressions-trend",
            "kind": "chart",
            "type": "line",
            "title": "Search impressions by source",
            "span": {
              "base": 12,
              "md": 6
            },
            "xLabel": "Week",
            "yLabel": "Impressions",
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "impressions"
                ]
              ],
              "x": "week",
              "groupBy": "source",
              "aggregate": {
                "op": "sum",
                "field": "value"
              },
              "window": "range"
            }
          },
          {
            "id": "conversions-stack",
            "kind": "chart",
            "type": "stackedBar",
            "title": "Conversions by source",
            "span": {
              "base": 12,
              "md": 6
            },
            "xLabel": "Week",
            "yLabel": "Conversions",
            "query": {
              "type": "metric",
              "where": [
                [
                  "name",
                  "==",
                  "conversions"
                ]
              ],
              "x": "week",
              "groupBy": "source",
              "aggregate": {
                "op": "sum",
                "field": "value"
              },
              "window": "range"
            }
          },
          {
            "id": "audit-pages",
            "kind": "table",
            "title": "Audited pages",
            "span": {
              "base": 12
            },
            "columns": [
              "url",
              "title",
              "checked",
              "issues"
            ],
            "link": true,
            "query": {
              "type": "audit",
              "orderBy": [
                "checked",
                "desc"
              ],
              "limit": 10
            }
          },
          {
            "id": "read-me",
            "kind": "text",
            "heading": "About this page",
            "text": "Numbers come from the last weekly run. Each tile shows the last full week (Monday to Sunday) against the week before. Position is an average, and lower is better. Use Refresh to read the data again.",
            "span": {
              "base": 12
            }
          }
        ]
      }
    ]
  }
}
