// Content QA Worker. Replace every REPLACE_ value before deploying.
// Set the access token with: npx wrangler secret put ACCESS_TOKEN
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "REPLACE_content-qa-worker",
  "main": "src/index.ts",
  // quickAction() on the browser binding needs 2026-03-24 or later (Cloudflare docs).
  "compatibility_date": "2026-11-04",
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "REPLACE_content-qa-shots" }],
  // Optional: uncomment to allow the vision note (also set VISION_CHECK to "on").
  // "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "ALLOWED_HOSTS": "REPLACE_your-store.com",
    "SHOTS_PER_CRON": "5",
    "LINK_TTL_SECONDS": "86400",
    "VISION_CHECK": "off"
  }
}
